# Clé API pour le service d'IA Pollination (OBLIGATOIRE pour le texte)
# Obtenez votre clé sur https://enter.pollinations.ai
POLLINATION_API_KEY=votre_clé_api_ici

# Clé API pour le service d'IA Venice (OBLIGATOIRE pour les images)
# Obtenez votre clé sur https://venice.ai/
VENICE_API_KEY=votre_clé_api_ici

# Numéro de téléphone pour la connexion par code de pairage (OBLIGATOIRE)
# Incluez l'indicatif du pays sans le "+" (par exemple, 33 pour la France)
PHONE_NUMBER=votre_numéro_de_téléphone_ici
