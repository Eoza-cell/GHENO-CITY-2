# Clé API pour Stable Horde (OBLIGATOIRE si vous n'utilisez pas le mode anonyme)
# Obtenez votre clé sur https://stablehorde.net/register
# Vous pouvez utiliser "0000000000" pour une utilisation anonyme à faible priorité.
STABLE_HORDE_API_KEY=0000000000

# Numéro de téléphone pour la connexion par code de pairage (OBLIGATOIRE)
# Incluez l'indicatif du pays sans le "+" (par exemple, 33 pour la France)
PHONE_NUMBER=votre_numéro_de_téléphone_ici
