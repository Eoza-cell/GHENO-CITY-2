# Numéro de téléphone pour la connexion par code de pairage (OBLIGATOIRE)
# Incluez l'indicatif du pays sans le "+" (par exemple, 33 pour la France)
PHONE_NUMBER=votre_numéro_de_téléphone_ici

# --- IA principale : Ollama local (illimité, tourne sur ta machine/serveur) ---
# Lance `bash install_gemma4.sh` pour installer Ollama + le modèle.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
# Fenêtre de contexte (Ollama utilise 4K par défaut, trop court pour ce jeu) :
OLLAMA_NUM_CTX=32768
# Temps max d'attente d'une réponse locale (ms) :
OLLAMA_TIMEOUT_MS=60000
# Nombre de tentatives supplémentaires si l'appel échoue :
OLLAMA_RETRIES=2

# Temps max (ms) laissé à l'ensemble du système IA (Ollama + secours) avant
# de basculer sur la réponse narrative locale de secours :
AI_TIMEOUT_MS=70000

# --- Secours uniquement (utilisés seulement si Ollama est injoignable) ---
# Puter API Key for Claude 3.5 Sonnet and Flux (Optional but recommended)
PUTER_API_KEY=

# OpenRouter API Key (Optional fallback)
OPENROUTER_API_KEY=
