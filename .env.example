# OBLIGATOIRE - Votre numéro WhatsApp avec indicatif pays (sans le +)
# Exemple: 33612345678
PHONE_NUMBER=votre_numéro_ici

# CONFIGURATION IA LOCALE (Ollama / vLLM)
AI_PROVIDER=local
LOCAL_API=http://127.0.0.1:11434
MODEL=qwen2.5:3b
# URL d'Ollama (Legacy)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# API EXTERNES (Optionnel - Fallbacks si Gemma 3 échoue)
PUTER_API_KEY=
OPENROUTER_API_KEY=
POLLINATIONS_API_KEY=

# CONFIGURATION SERVEUR
PORT=3000
MODEL_PORT=3001
