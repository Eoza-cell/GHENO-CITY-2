# Numéro de téléphone pour la connexion par code de pairage (OBLIGATOIRE)
# Incluez l'indicatif du pays sans le "+" (par exemple, 33 pour la France)
PHONE_NUMBER=votre_numéro_de_téléphone_ici

# Puter API Key for Free Unlimited OpenAI (OBLIGATOIRE pour la stabilité)
# Obtenez-la sur https://puter.com/
PUTER_API_KEY=

# ApiFreeLLM API Key (Optionnel)
APIFREELLM_API_KEY=
APIFREELLM_BASE_URL=https://api.apifreellm.com/v1

# OpenRouter API Key (Optionnel)
OPENROUTER_API_KEY=
