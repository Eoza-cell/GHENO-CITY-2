# Numéro de téléphone pour la connexion par code de pairage (OBLIGATOIRE)
PHONE_NUMBER=votre_numéro_de_téléphone_ici

# --- IA Puter (moteur principal, OpenAI gratuit) ---
# Token créé sur https://puter.com/dashboard → Account → Create token
# Sans token, Puter répond 401 : l'IA retombe sur les moteurs de secours.
PUTER_TOKEN=
# Chaîne de modèles essayés dans l'ordre jusqu'au premier succès
PUTER_MODELS=gpt-5.4-nano,gpt-4o-mini,gpt-4o,gpt-5.4
PUTER_TIMEOUT_MS=45000
PUTER_IMAGE_MODEL=gpt-image-2.5-flare

# --- IA RP de secours : Empero Qwythos-9B-v2 via Ollama ---
# Modèle Empero : https://huggingface.co/empero-ai/Qwythos-9B-v2
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwythos-9b-v2

# Paramètres Empero recommandés
OLLAMA_NUM_CTX=32768
OLLAMA_TIMEOUT_MS=120000
EMPERO_TEMPERATURE=0.6
EMPERO_TOP_P=0.95
EMPERO_TOP_K=20
EMPERO_REPETITION_PENALTY=1.05

# --- Mémoire RAG ---
# Les embeddings Transformers restent indépendants du modèle RP.
RAG_TOP_K=6
RAG_MIN_SCORE=0.30
