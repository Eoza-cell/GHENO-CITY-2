# Numéro de téléphone pour la connexion par code de pairage (OBLIGATOIRE)
# Incluez l'indicatif du pays sans le "+" (par exemple, 33 pour la France)
PHONE_NUMBER=votre_numéro_de_téléphone_ici

# Puter API Key for Claude 3.5 Sonnet and Flux (Optional but recommended)
PUTER_API_KEY=

# OpenRouter API Key (Optional fallback)
OPENROUTER_API_KEY=

# Ollama Configuration (Local AI)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
