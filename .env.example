# OBLIGATOIRE - Votre numéro WhatsApp avec indicatif pays (sans le +)
# Exemple: 33612345678
PHONE_NUMBER=votre_numéro_ici

# CONFIGURATION GEMMA 3 (Ollama)
# URL d'Ollama (défaut: http://localhost:11434)
OLLAMA_URL=http://localhost:11434
# Modèle Gemma 3 à utiliser (gemma3:1b, gemma3:4b, gemma3:12b, gemma3:27b)
OLLAMA_MODEL=gemma3:4b

# API EXTERNES (Optionnel - Fallbacks si Gemma 3 échoue)
PUTER_API_KEY=
OPENROUTER_API_KEY=
POLLINATIONS_API_KEY=

# CONFIGURATION SERVEUR
PORT=3000
MODEL_PORT=3001
