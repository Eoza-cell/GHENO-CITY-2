# WhatsApp : numéro au format international, chiffres uniquement (sans + ni espaces)
PHONE_NUMBER=226XXXXXXXX

# PostgreSQL Aiven (obligatoire sur Render : plus de repli SQLite)
# Copie l'URL de connexion Aiven dans Render > Environment.
# Utilise DATABASE_URL ou AIVEN_DATABASE_URL ; SSL est activé automatiquement.
DATABASE_URL=postgres://avnadmin:VOTRE_MOT_DE_PASSE@VOTRE_HOTE_AIVEN:PORT/defaultdb?sslmode=require

# --- IA RP unique : Empero Qwythos-9B-v2 via Ollama ---
# Modèle Empero : https://huggingface.co/empero-ai/Qwythos-9B-v2
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwythos-9b-v2

# Paramètres Empero recommandés
OLLAMA_NUM_CTX=32768
OLLAMA_TIMEOUT_MS=120000
EMPERO_TEMPERATURE=0.6
EMPERO_TOP_P=0.95
EMPERO_TOP_K=20
EMPERO_REPETITION_PENALTY=1.05

# --- Mémoire RAG ---
# Les embeddings Transformers restent indépendants du modèle RP.
RAG_TOP_K=6
RAG_MIN_SCORE=0.30
