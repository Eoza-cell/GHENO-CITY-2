# OBLIGATOIRE - Votre numéro WhatsApp avec indicatif pays (sans le +)
# Exemple: 33612345678
PHONE_NUMBER=votre_numéro_ici

# CONFIGURATION IA LOCALE (Ollama)
# URL d'Ollama (défaut: http://localhost:11434)
OLLAMA_URL=http://localhost:11434
# Modèle à utiliser (Recommandé: qwen2.5:3b ou gemma3:4b)
OLLAMA_MODEL=qwen2.5:3b

# API EXTERNES (Optionnel - Fallbacks si Gemma 3 échoue)
PUTER_API_KEY=
OPENROUTER_API_KEY=
POLLINATIONS_API_KEY=

# CONFIGURATION SERVEUR
PORT=3000
MODEL_PORT=3001
